---
import Story from "@/components/slides/Story.astro";

const notes = "About 60 seconds. The second story. The guard is the database's deadlock detector. The camera covers the database. The corner is your application's memory. First half of the story: a deadlock the guard can see, and fixes on its own. Second half: the same standoff, with one person out of view. The guard sees someone waiting and assumes it's normal. \"Next slide: the half the guard can see.\"";
---

<Story
  dark
  notes={notes}
  kicker="scenario 2"
  title="half the hallway"
  lines={[
    "two people meet in a narrow hallway. each waits for the other to step aside.",
    "a guard watching the camera sees it, and sends one of them back.",
    "now the hallway turns a corner. one person stands just out of view.",
    ["the guard sees one person waiting. that looks normal.", "muted"],
  ]}
  punchline="so the guard waits too. so does everyone behind them."
/>
