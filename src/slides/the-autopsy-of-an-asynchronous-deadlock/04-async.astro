---
import Slide from "@/components/slides/Slide.astro";
import { Code } from "astro:components";

const notes =
    "what asynchronous means:\n- synchronous: do one thing, stand there until it finishes, then do the next\n- asynchronous: start it, go do something else, come back when it's ready\n\nnote: nothing in the talk depends on rust or tokio.";
---

<Slide
    kicker="async, for everyone"
    title="await means: wake me when it's ready."
    notes={notes}
>
    <table class="s-table">
        <thead>
            <tr>
                <th>language</th>
                <th>the same idea</th>
            </tr>
        </thead>
        <tbody>
            {[
                ["javascript", "javascript", "const res = await fetch(url);"],
                ["python", "python", "res = await session.get(url)"],
                ["c#", "csharp", "var res = await client.GetAsync(url);"],
                ["rust", "rust", "let res = client.get(url).send().await?;"],
            ].map(([name, lang, code]) => (
                <tr>
                    <td>{name}</td>
                    <td>
                        <Code
                            code={code}
                            lang={lang as any}
                            theme="css-variables"
                            inline
                        />
                    </td>
                </tr>
            ))}
        </tbody>
    </table>
    <div class="s-card is-accent">
        <p>a few threads run thousands of tasks.</p>
        <p class="s-muted">
            a task that awaits gives its thread back, and waits on a shelf until
            something wakes it up.
        </p>
    </div>
</Slide>
