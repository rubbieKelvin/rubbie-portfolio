---
import Slide from "@/components/slides/Slide.astro";
import WitnessLoop from "@/components/slides/WitnessLoop.astro";

const notes = "About 90 seconds. Space draws the three arrows, then once per witness; the last press brings the whole loop back.\n\n- the loop: handler awaits worker, worker waits for row 42, row 42 is held by the handler\n- database: sees a queue, not a loop. the session is \"idle in transaction\", so its deadlock detector stays quiet\n- runtime: sees two idle tasks, which is normal\n- only your code knows the await that closes the loop. no tool sees it";
---

<Slide kicker="scenario 1 · the stockroom key" title="why nobody catches it." notes={notes}>
  <WitnessLoop
    id="s8"
    nodes={[
      { id: "handler", label: "the handler", kind: "task", x: 170, y: 60, notes: { runtime: "idle" } },
      { id: "worker", label: "the worker", kind: "task", x: 830, y: 60, notes: { runtime: "idle" } },
      { id: "row", label: "row 42", kind: "resource", x: 500, y: 240 },
    ]}
    edges={[
      { from: "handler", to: "worker", kind: "wait", label: "awaits", seenBy: ["code"], caption: "the handler awaits the worker's reply." },
      { from: "worker", to: "row", kind: "wait", label: "waits for", seenBy: ["database"], caption: "the worker waits for the lock on row 42." },
      { from: "row", to: "handler", kind: "held", label: "held by", seenBy: ["database"], caption: "row 42's lock is held by the handler's open transaction. the loop is closed." },
    ]}
    witnesses={[
      { id: "database", name: "what the database sees", caption: "a queue, not a loop: the worker waits behind a session that's doing nothing. its deadlock detector stays quiet." },
      { id: "runtime", name: "what the runtime sees", caption: "two idle tasks. cpu 0%. health check green." },
      { id: "code", name: "what only your code knows", caption: "the handler awaits the worker. that arrow closes the loop, and no tool sees it." },
    ]}
    final={{ name: "put together", caption: "the loop closes through an await. only you can see the whole thing." }}
  />
</Slide>
