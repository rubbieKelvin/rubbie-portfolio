---
import Slide from "@/components/slides/Slide.astro";
import Table from "@/components/slides/Table.astro";

const notes = "About 90 seconds. Follow the arrows: the handler waits for the worker, the worker waits for the row lock, and the lock is held by the handler. Back where we started: a loop. Postgres has a good deadlock detector: if two transactions each wait for the other's lock, it notices within about a second and cancels one. But it only follows waits between database sessions. Here it sees the worker waiting behind a session that is \"idle in transaction\", meaning doing nothing it knows about. That looks like a queue that will clear any moment. The runtime sees two parked tasks, which is what tasks do all day. The arrow that closes the loop is an await. No database can see your code.";
---

<Slide kicker="scenario 1 · the stockroom key" title="why nobody catches it." notes={notes}>
  <Table
    head={["from", "arrow", "to", "seen by"]}
    rows={[
      ["the handler", "awaits", "the worker's reply", "your code only"],
      ["the worker", "waits for", "the lock on row 42", "the database"],
      ["row 42's lock", "is held by", "the handler's open transaction", "the database"],
    ]}
    highlight={0}
  />
  <div class="s-cols" style="--cols: 3">
    <div class="s-card"><p class="s-card-label">the database</p><p>sees a queue, not a loop. its deadlock detector stays quiet.</p></div>
    <div class="s-card"><p class="s-card-label">the runtime</p><p>sees two idle tasks. cpu 0%. health check green.</p></div>
    <div class="s-card is-accent"><p class="s-card-label">the loop</p><p>closes through an await in your code. only you can see that arrow.</p></div>
  </div>
</Slide>
