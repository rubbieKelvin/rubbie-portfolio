---
import Slide from "@/components/slides/Slide.astro";
import Table from "@/components/slides/Table.astro";

const notes =
    "Show tokio-console live on the frozen demo (the table is illustrative).\n\n- the database told us the worker waits. now: why is the handler idle?\n- two tasks idle for minutes, poll count stopped: ran a couple of times, never woken again\n- the heartbeat keeps waking, so the runtime itself is fine\n- put the halves together: database says the worker waits for the handler, runtime says the handler waits for the worker. that's the loop\n- neither tool shows it alone. that's the core lesson of the talk";
---

<Slide
    kicker="scenario 1 · the autopsy"
    title="step 2: ask the runtime."
    notes={notes}
>
    <div class="s-cols" style="grid-template-columns: 3fr 2fr">
        <div>
            <p class="s-small mb-[0.5em]">
                tokio-console, tasks view (illustrative)
            </p>
            <Table
                head={["task", "state", "idle for", "polls"]}
                rows={[
                    ["mark_paid", "idle", "4m 12s", "3"],
                    ["send_receipt", "idle", "4m 11s", "2"],
                    ["heartbeat", "idle", "1s", "253"],
                ]}
            />
            <p class="s-small mt-[1em]">
                the same view elsewhere: python asyncio.all_tasks() · c#
                parallel stacks › tasks · go goroutine dump
            </p>
        </div>
        <div class="s-lines">
            <div class="s-card">
                <p class="s-card-label">the database said</p>
                <p>the worker waits for the handler's transaction.</p>
            </div>
            <div class="s-card">
                <p class="s-card-label">the runtime says</p>
                <p>the handler waits for the worker.</p>
            </div>
            <div class="s-card is-accent">
                <p class="s-card-label">put them together</p>
                <p>a loop.</p>
            </div>
        </div>
    </div>
    <p class="mt-auto s-big">
        neither tool shows a deadlock.{" "}
        <span class="s-accent">you draw the last arrow yourself.</span>
    </p>
</Slide>
