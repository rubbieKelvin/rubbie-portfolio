---
import Slide from "@/components/slides/Slide.astro";

const notes = "About 90 seconds, then questions. Five habits to have in place before the next deadlock, because once you're in one, it's too late to add them. Each one maps to something we needed today: the heartbeat answered \"is it a deadlock?\"; lock logs gave us the arrow no tool shows; report-only timeouts tell you which wait is stuck without destroying the evidence; database deadlines turn freezes into errors; and the last one prevents both scenarios outright.";
---

<Slide dark kicker="before the next one" title="five habits." notes={notes}>
  <ol class="s-lines habits">
    <li>give every service a heartbeat and a progress counter.</li>
    <li>log when you take a lock, not only when you wait for one.</li>
    <li>use timeouts that report, not cancel.</li>
    <li>set idle_in_transaction_session_timeout and lock_timeout.</li>
    <li>never await while holding a transaction, a lock or a connection.</li>
  </ol>
</Slide>

<style>
  .habits { list-style: decimal-leading-zero; padding-left: 2.5em; }
  .habits li::marker { color: var(--color-accent); }
</style>
