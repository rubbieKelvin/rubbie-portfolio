---
import Slide from "@/components/slides/Slide.astro";
import Code from "@/components/slides/Code.astro";

const notes =
    "- the classic: two bank transfers in opposite directions. a locks row 1 and wants row 2, b locks row 2 and wants row 1\n- both locks are in the database, so the guard sees the whole loop\n- after deadlock_timeout (1s by default) Postgres finds the loop and aborts one transaction (SQLSTATE 40P01), printing both halves of the loop\n- this is the guard doing its job. every deadlock after this one, we reconstruct that message ourselves\n- the fix: take locks in a consistent order (e.g. by id), and retry on 40P01";
---

<Slide
    kicker="scenario 2 · half the hallway"
    title="first, the one the database catches."
    notes={notes}
>
    <div class="s-cols">
        <Code
            label="transaction a"
            lines={[
                ["update accounts … id = 1;", "← locks row 1"],
                ["update accounts … id = 2;", "← waits for b", "accent"],
            ]}
        />
        <Code
            label="transaction b"
            lines={[
                ["update accounts … id = 2;", "← locks row 2"],
                ["update accounts … id = 1;", "← waits for a", "accent"],
            ]}
        />
    </div>
    <Code
        lines={[
            ["ERROR: deadlock detected", "", "accent"],
            "DETAIL: Process 130 waits for ShareLock on transaction 741; blocked by process 129.",
            "        Process 129 waits for ShareLock on transaction 740; blocked by process 130.",
        ]}
    />
    <p>
        both locks are in the database, so the guard sees the whole loop. about
        a second later, one side gets an error it can retry.
    </p>
</Slide>
