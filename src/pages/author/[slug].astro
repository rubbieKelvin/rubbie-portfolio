---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import PostList from "@/components/PostList.astro";

export async function getStaticPaths() {
  const authors = await getCollection("authors");
  return authors.map((author) => ({
    params: { slug: author.data.slug },
    props: { author },
  }));
}

const { author } = Astro.props as { author: any };

if (!author) {
  return Astro.redirect("/404");
}

const posts = await getCollection("posts", ({ data }) => {
  return data.author === author.data.slug;
});

const ogImageUrl = author.data.image || undefined;
---

<Layout title={`${author.data.name}`} image={ogImageUrl}>
  <div class="stack mb-8">
    {
      author.data.image && (
        <img src={author.data.image} alt={author.data.name} class="w-16 h-16 object-cover" />
      )
    }
    <h1 class="title !mb-0">{author.data.name.toLowerCase()}</h1>
    {
      author.data.bio && (
        <div class="muted stack">
          <Fragment set:html={author.data.bio} />
        </div>
      )
    }
    <p class="small muted">
      {posts.length} {posts.length === 1 ? "post" : "posts"}
    </p>
    {
      author.data.links && author.data.links.length > 0 && (
        <div class="slash-list">
          {author.data.links.map((link: any) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="underline-link">
              {link.title.toLowerCase()}
            </a>
          ))}
        </div>
      )
    }
  </div>

  {
    posts.length > 0 ? (
      <PostList posts={posts} />
    ) : (
      <p class="muted">no posts yet.</p>
    )
  }
</Layout>
