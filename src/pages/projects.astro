---
import Layout from "@/layouts/Layout.astro";
import ProjectList from "@/components/ProjectList.astro";
import { getCollection } from "astro:content";

const categories = await getCollection("categories", ({ data }) => {
  return data.is_project_category === true;
});

const projects = await getCollection("projects");

const detailIds = new Set(
  (await getCollection("projectDetails")).map((d) => d.id),
);

const projectsByCategory = categories
  .map((cat) => ({
    title: cat.data.title,
    projects: projects.filter((proj) =>
      proj.data.categories.includes(cat.id),
    ),
  }))
  .filter((group) => group.projects.length > 0);
---

<Layout title="Projects">
  <ProjectList
    title="projects"
    description="from learning experiments to professional tools, each project is part of my story."
    groups={projectsByCategory}
    detailed={detailIds}
  />
</Layout>
