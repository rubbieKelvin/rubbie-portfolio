---
import Layout from "@/layouts/Layout.astro";
import { render } from "astro:content";
import { getTalks, slidesUrl, youtubeId, type Talk } from "@/lib/talks";

export async function getStaticPaths() {
    const talks = await getTalks();
    return talks.map((talk) => ({
        params: { slug: talk.id },
        props: { talk },
    }));
}

const { talk } = Astro.props as { talk: Talk };
const {
    title,
    date,
    event,
    eventUrl,
    location,
    description,
    cover,
    resources,
} = talk.data;
const { Content } = await render(talk);

const videoId = youtubeId(cover);
const slides = slidesUrl(talk);
const slidesExternal = slides ? /^https?:\/\//.test(slides) : false;

const fmtDate = (d: Date) =>
    d
        .toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
        })
        .toLowerCase();
---

<Layout
    title={title}
    description={description}
    image={videoId ? `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg` : cover}
    wide
    stickyTitle={title.toLowerCase()}
>
    <header class="mb-8">
        <h1 class="title">{title.toLowerCase()}</h1>
        <p class="small muted">
            <time datetime={date.toISOString()}>{fmtDate(date)}</time>
            {event && (
                <>
                    {" "}
                    /{" "}
                    {eventUrl ? (
                        <a
                            href={eventUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="underline-link"
                        >
                            {event.toLowerCase()}
                        </a>
                    ) : (
                        event.toLowerCase()
                    )}
                </>
            )}
            {location && <> / {location.toLowerCase()}</>}
        </p>
    </header>

    {videoId ? (
        <div class="talk-cover">
            <iframe
                src={`https://www.youtube-nocookie.com/embed/${videoId}`}
                title={title}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
            />
        </div>
    ) : (
        cover && (
            <div class="talk-cover">
                <img src={cover} alt={title} />
            </div>
        )
    )}

    {slides && (
        <p class="mt-4 mb-8">
            <a
                href={slides}
                class="underline-link"
                target={slidesExternal ? "_blank" : undefined}
                rel={slidesExternal ? "noopener noreferrer" : undefined}
            >
                ▶ play slides
            </a>
        </p>
    )}

    <div class="prose max-w-none">
        <Content />
    </div>

    {resources.length > 0 && (
        <section class="mt-10">
            <h2 class="heading">resources</h2>
            <div class="links-list">
                {resources.map((r) => (
                    <a
                        href={r.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="underline-link"
                    >
                        {r.label.toLowerCase()}
                    </a>
                ))}
            </div>
        </section>
    )}
</Layout>
