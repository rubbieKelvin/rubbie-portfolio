---
import "@/assets/global.css";
import { getTalks, getSlides, type Talk } from "@/lib/talks";
import Presenter from "@/components/slides/Presenter.astro";

export async function getStaticPaths() {
  const talks = await getTalks();
  return talks
    .filter((talk) => getSlides(talk.id).length > 0)
    .map((talk) => ({ params: { slug: talk.id }, props: { talk } }));
}

const { talk } = Astro.props as { talk: Talk };
const slides = getSlides(talk.id);
const dev = import.meta.env.DEV;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{talk.data.title} (slides) | Rubbie Kelvin</title>
    <script is:inline>
      (function () {
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch (e) {}
        const dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = stored || (dark ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
  </head>

  <body class="deck-body">
    <main class="deck" data-talk={talk.id}>
      {
        slides.map((Slide, i) => (
          <section class="slide" data-index={i} aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`} hidden={i !== 0}>
            <Slide />
          </section>
        ))
      }
    </main>

    <nav class="deck-controls small muted">
      <a href={`/talks/${talk.id}`} class="nav-link">← {talk.data.title.toLowerCase()} (esc)</a>
      <span class="flex items-center gap-4">
        <button type="button" data-prev class="nav-link" aria-label="Previous slide">prev</button>
        <button type="button" data-counter class="nav-link" title="go to slide (g)">1 / {slides.length}</button>
        <form data-goto class="deck-goto" hidden>
          <input
            type="number"
            inputmode="numeric"
            aria-label="Go to slide"
            class="filter-input"
          />
          <span>/ {slides.length}</span>
        </form>
        <button type="button" data-next class="nav-link" aria-label="Next slide">next</button>
        <button type="button" data-restart class="nav-link">restart (r)</button>
        <button type="button" data-fullscreen class="nav-link">fullscreen (f)</button>
        {dev && <button type="button" data-open-presenter class="nav-link">presenter (p)</button>}
      </span>
    </nav>
    <div class="deck-progress" aria-hidden="true"><span data-progress></span></div>
    {dev && <Presenter />}

    <script>
      const deck = document.querySelector<HTMLElement>(".deck")!;
      const talkUrl = `/talks/${deck.dataset.talk}`;
      const slides = Array.from(document.querySelectorAll<HTMLElement>(".slide"));
      const counter = document.querySelector<HTMLElement>("[data-counter]")!;
      const progress = document.querySelector<HTMLElement>("[data-progress]")!;
      let current = -1;

      // Dev only: a speaker view (Presenter.astro) at ?presenter in a second window.
      // Both windows share a channel and follow each other's slide changes.
      const presenter = import.meta.env.DEV && new URLSearchParams(location.search).has("presenter");
      const channel = import.meta.env.DEV ? new BroadcastChannel(`deck:${deck.dataset.talk}`) : null;

      // Slides can listen for these to start/stop their own animations:
      //   slide.addEventListener("slide:enter", ...) / "slide:leave"
      // and for "slide:advance" (space): a slide with a step left takes it and calls
      // preventDefault(); otherwise the deck moves on to the next slide.
      // `broadcast` is false when following the other window, so changes don't echo back.
      function go(n: number, broadcast = true) {
        const next = Math.max(0, Math.min(slides.length - 1, n));
        if (next === current) return;
        // the speaker view never shows the slides, so don't start their animations there
        if (current >= 0 && !presenter) slides[current].dispatchEvent(new CustomEvent("slide:leave"));
        current = next;
        slides.forEach((s, i) => (s.hidden = i !== current));
        if (!presenter) {
          document.body.toggleAttribute("data-slide-dark", !!slides[current].querySelector("[data-dark]"));
          slides[current].dispatchEvent(new CustomEvent("slide:enter"));
        }
        counter.textContent = `${current + 1} / ${slides.length}`;
        progress.style.width = `${((current + 1) / slides.length) * 100}%`;
        history.replaceState(null, "", `${location.search}#${current + 1}`);
        deck.dataset.current = String(current);
        document.dispatchEvent(new CustomEvent("deck:go", { detail: current }));
        if (broadcast) channel?.postMessage({ type: "go", index: current });
      }

      // Space: the current slide's next step, or the next slide when it has none left.
      // In the speaker view the slides aren't live, so it asks the deck window to do it.
      function advance() {
        if (presenter) {
          channel?.postMessage({ type: "advance" });
          return;
        }
        const step = new CustomEvent("slide:advance", { cancelable: true });
        slides[current].dispatchEvent(step);
        if (!step.defaultPrevented) go(current + 1);
      }

      const fromHash = () => (parseInt(location.hash.slice(1), 10) || 1) - 1;
      // the speaker view starts wherever the deck is, so it asks instead of announcing
      go(fromHash(), !presenter);
      if (channel) {
        channel.addEventListener("message", ({ data }) => {
          if (data.type === "go") go(data.index, false);
          else if (data.type === "advance" && !presenter) advance();
          else if (data.type === "hello") channel.postMessage({ type: "go", index: current });
        });
        if (presenter) channel.postMessage({ type: "hello" });
      }

      const openPresenter = import.meta.env.DEV
        ? () => window.open(`${location.pathname}?presenter#${current + 1}`, `presenter:${deck.dataset.talk}`, "popup,width=960,height=720")
        : null;
      window.addEventListener("hashchange", () => go(fromHash()));

      const gotoForm = document.querySelector<HTMLFormElement>("[data-goto]")!;
      const gotoInput = gotoForm.querySelector("input")!;

      function openGoto() {
        counter.hidden = true;
        gotoForm.hidden = false;
        gotoInput.value = "";
        gotoInput.placeholder = String(current + 1);
        gotoInput.focus();
      }

      function closeGoto() {
        if (gotoForm.hidden) return;
        gotoForm.hidden = true;
        counter.hidden = false;
        // hand focus back so the arrow keys keep working
        gotoInput.blur();
      }

      gotoForm.addEventListener("submit", (e) => {
        e.preventDefault();
        // out-of-range numbers clamp to the first/last slide
        const n = parseInt(gotoInput.value, 10);
        if (!Number.isNaN(n)) go(n - 1);
        closeGoto();
      });
      gotoInput.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          e.preventDefault();
          closeGoto();
        }
      });
      gotoInput.addEventListener("blur", closeGoto);
      counter.addEventListener("click", openGoto);

      function toggleFullscreen() {
        if (document.fullscreenElement) document.exitFullscreen();
        else document.documentElement.requestFullscreen?.();
      }

      document.addEventListener("keydown", (e) => {
        const t = e.target as HTMLElement;
        if (t.closest("input, textarea, select, [contenteditable]")) return;
        if (e.key === " ") advance();
        else if (["ArrowRight", "ArrowDown", "PageDown"].includes(e.key)) go(current + 1);
        else if (["ArrowLeft", "ArrowUp", "PageUp"].includes(e.key)) go(current - 1);
        else if (e.key === "Home") go(0);
        else if (e.key === "End") go(slides.length - 1);
        else if (e.key === "f") toggleFullscreen();
        else if (e.key === "r") go(0);
        else if (e.key === "g") openGoto();
        else if (openPresenter && e.key === "p" && !presenter) openPresenter();
        // In fullscreen the browser uses Esc to exit fullscreen, so only leave the deck outside it.
        else if (e.key === "Escape" && !document.fullscreenElement && !presenter) location.href = talkUrl;
        else return;
        e.preventDefault();
      });

      // a focused button would also "click" on space; space belongs to the deck
      document.addEventListener("keyup", (e) => {
        if (e.key === " " && (e.target as HTMLElement).closest("button")) e.preventDefault();
      });

      document.querySelector("[data-prev]")!.addEventListener("click", () => go(current - 1));
      document.querySelector("[data-next]")!.addEventListener("click", () => go(current + 1));
      document.querySelector("[data-restart]")!.addEventListener("click", () => go(0));
      document.querySelector("[data-fullscreen]")!.addEventListener("click", toggleFullscreen);
      if (openPresenter) document.querySelector("[data-open-presenter]")!.addEventListener("click", openPresenter);

      let touchX: number | null = null;
      document.addEventListener("touchstart", (e) => (touchX = e.touches[0].clientX), { passive: true });
      document.addEventListener("touchend", (e) => {
        if (touchX === null) return;
        const dx = e.changedTouches[0].clientX - touchX;
        if (Math.abs(dx) > 50) go(current + (dx < 0 ? 1 : -1));
        touchX = null;
      });
    </script>
  </body>
</html>
