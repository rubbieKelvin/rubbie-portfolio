---
import Layout from "@/layouts/Layout.astro";
import AppFooter from "@/components/AppFooter.astro";
import Image from "@/components/Image.astro";
import { getCollection, getEntry, render } from "astro:content";

export async function getStaticPaths() {
  const details = await getCollection("projectDetails");
  return details.map((detail) => ({
    params: { slug: detail.id },
    props: { detail },
  }));
}

const { detail } = Astro.props as { detail: any };

const project = await getEntry("projects", detail.id);

if (!project) {
  return Astro.redirect("/404");
}

const { Content } = await render(detail);

const displayUrl = project.data.url;
const domainOf = (url: string) => {
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return null;
  }
};
---

<Layout
  title={project.data.title}
  description={detail.data.description ?? project.data.description ?? undefined}
  image={project.data.mainImage ?? undefined}
>
  <div class="px-5 lg:px-0 pb-10">
    <!-- Back to projects -->
    <div class="py-5">
      <a href="/projects" class="text-sm cursor-after-effect hidden lg:block"
        >&larr; Back to Projects</a
      >
    </div>

    <!-- Project header -->
    <article class="md:max-w-3xl">
      <header class="mb-8">
        <h1 class="text-4xl lg:text-5xl mb-4 leading-tight">
          {project.data.title}
        </h1>

        <div
          class="flex flex-wrap items-center gap-2 text-sm"
          style="color: var(--color-text-muted)"
        >
          {project.data.categories.map((category: string) => (
            <span class="px-2 py-1 rounded text-xs bg-accent-bg text-text">
              {category}
            </span>
          ))}
          {detail.data.stack.length > 0 && (
            <span class="text-xs">{detail.data.stack.join(" · ")}</span>
          )}
        </div>

        {
          displayUrl && (
            <div
              class="mt-6 p-4 rounded-lg bg-blue-50 border border-blue-200 dark:bg-blue-900/40 dark:border-blue-500/20"
            >
              <p class="mb-2 text-text">
                {domainOf(displayUrl) === "github.com" ? (
                  <>Source code on GitHub</>
                ) : (
                  <>View the project</>
                )}
              </p>
              <a
                href={displayUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-sm text-blue-500 cursor-after-effect"
              >
                → {displayUrl.replace(/^https?:\/\//, "")}
              </a>
            </div>
          )
        }

        {
          project.data.mainImage && (
            <div class="mt-8 mb-8">
              <Image
                src={project.data.mainImage}
                alt={project.data.title}
                class="w-full h-64 lg:h-96 object-cover rounded-lg"
              />
            </div>
          )
        }
      </header>

      <!-- Case study -->
      <div class="prose prose-lg max-w-none">
        <Content />
      </div>
    </article>

    <!-- Navigation footer -->
    <div class="mt-12 pt-8 pb-4">
      <a href="/projects" class="text-sm cursor-after-effect">
        &larr; Back to projects
      </a>
    </div>
    <AppFooter />
  </div>
</Layout>
