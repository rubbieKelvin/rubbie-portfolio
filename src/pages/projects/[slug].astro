---
import Layout from "@/layouts/Layout.astro";
import Image from "@/components/Image.astro";
import { getCollection, getEntry, render } from "astro:content";

export async function getStaticPaths() {
  const details = await getCollection("projectDetails");
  return details.map((detail) => ({
    params: { slug: detail.id },
    props: { detail },
  }));
}

const { detail } = Astro.props as { detail: any };
const project = await getEntry("projects", detail.id);

if (!project) {
  return Astro.redirect("/404");
}

const { Content } = await render(detail);

const links =
  detail.data.links.length > 0
    ? detail.data.links
    : project.data.url
      ? [{ label: "View project", url: project.data.url }]
      : [];
---

<Layout
  title={project.data.title}
  description={detail.data.description ?? project.data.description ?? undefined}
  image={project.data.mainImage ?? undefined}
  wide
>
  <header class="stack mb-8">
    <h1 class="title !mb-0">{project.data.title.toLowerCase()}</h1>
    {detail.data.description && <p class="muted">{detail.data.description}</p>}
    <p class="small muted">
      {project.data.categories.map((c: string) => `#${c}`).join(" ")}
      {detail.data.stack.length > 0 && ` / ${detail.data.stack.join(" · ").toLowerCase()}`}
    </p>
    {
      links.length > 0 && (
        <div class="links-list">
          {links.map((link: { label: string; url: string }) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="underline-link">
              {link.label.toLowerCase()}
            </a>
          ))}
        </div>
      )
    }
  </header>

  {
    project.data.mainImage && (
      <Image src={project.data.mainImage} alt={project.data.title} class="w-full mb-8" />
    )
  }

  <div class="prose max-w-none">
    <Content />
  </div>
</Layout>
