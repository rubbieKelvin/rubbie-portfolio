---
import Layout from "@/layouts/Layout.astro";
import PostList from "@/components/PostList.astro";
import AppFooter from "@/components/AppFooter.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts");
---

<Layout title="Blog">
  <div class="px-5 lg:px-0">
    <div class="pt-10 pb-6">
      <div class="flex items-center justify-between">
        <h1 class="text-5xl">
          <span class="animate-pulse">&gt;</span><span>Blog</span>
        </h1>
        <a
          href="/rss.xml"
          class="mt-1 text-sm cursor-underline-effect text-gray-500"
          >~ $ wget rss.xml</a
        >
      </div>
      <h2 class="mt-3 xl:max-w-[70%] text-text-muted">
        Thoughts, tutorials, and insights from my development journey, sharing
        things i learn & create along the way.
      </h2>
    </div>

    <PostList posts={posts} />

    <AppFooter />
  </div>
</Layout>
