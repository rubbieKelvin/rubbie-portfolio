---
import Layout from "@/layouts/Layout.astro";
import PostList from "@/components/PostList.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts");
---

<Layout title="Blog">
  <div class="max-w-5xl mx-auto px-6">
    <section
      class="pt-14 pb-10 border-b-2"
      style="border-color: var(--color-border)"
    >
      <p
        class="text-xs uppercase tracking-widest font-semibold text-text-muted mb-3"
      >
        Writing
      </p>
      <h1
        class="font-display font-black uppercase text-5xl md:text-6xl leading-none tracking-tight mb-5"
        style="color: var(--color-text)"
      >
        Blog
      </h1>
      <div class="flex items-center justify-between gap-4">
        <p class="text-text-muted text-sm max-w-lg">
          Thoughts, tutorials, and insights from my development journey —
          things I learn and create along the way.
        </p>
        <a
          href="/rss.xml"
          class="text-xs font-semibold uppercase tracking-widest text-text-muted hover:text-accent transition-colors shrink-0"
        >
          RSS →
        </a>
      </div>
    </section>

    <div class="pt-10">
      <PostList posts={posts} />
    </div>
  </div>
</Layout>
