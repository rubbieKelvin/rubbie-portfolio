---
import Layout from "@/layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props as { post: any };

if (!post) {
  return Astro.redirect("/404");
}

const { Content } = await render(post);

const formatDate = (dateString: string) =>
  new Date(dateString).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

const {
  title,
  description,
  publishedAt,
  mainImage,
  external_link,
  categories,
  author: authorSlug,
} = post.data;

const author = authorSlug ? await getEntry("authors", authorSlug) : null;
---

<Layout
  title={title}
  description={description ?? undefined}
  image={mainImage ?? undefined}
  article={publishedAt ? { publishedAt: publishedAt.toISOString() } : undefined}
  wide
>
  <header class="mb-8">
    <h1 class="title">{title.toLowerCase()}</h1>
    <p class="small muted">
      {publishedAt && (
        <time datetime={publishedAt.toISOString()}>
          {formatDate(publishedAt.toISOString()).toLowerCase()}
        </time>
      )}
      {author && (
        <>
          {" "}/ by{" "}
          <a href={`/author/${author.data.slug}`} class="underline-link">
            {author.data.name.toLowerCase()}
          </a>
        </>
      )}
      {categories && categories.length > 0 && (
        <>{" "}/ {categories.map((c: string) => `#${c}`).join(" ")}</>
      )}
    </p>
  </header>

  {
    mainImage && (
      <img
        src={mainImage}
        alt={title}
        id="hero-image-trigger"
        class="w-full mb-8 cursor-zoom-in"
        tabindex="0"
        role="button"
        aria-label="Click to enlarge image"
      />
    )
  }

  {
    external_link && (
      <p class="mb-8 muted">
        originally published externally.{" "}
        <a href={external_link} target="_blank" rel="noopener noreferrer" class="underline-link">
          read the original
        </a>
      </p>
    )
  }

  <div class="prose max-w-none">
    <Content />
  </div>
</Layout>

{
  mainImage && (
    <>
      <div
        id="lightbox"
        class="fixed inset-0 z-50 hidden items-center justify-center cursor-zoom-out"
        style="background: rgba(0,0,0,0.92)"
        role="dialog"
        aria-modal="true"
        aria-label="Image lightbox"
      >
        <img
          id="lightbox-img"
          src={mainImage}
          alt={title}
          class="w-[85vw] h-[75vh] object-contain select-none"
        />
      </div>

      <script>
        const trigger = document.getElementById("hero-image-trigger");
        const lightbox = document.getElementById("lightbox");

        function open() {
          lightbox.classList.remove("hidden");
          lightbox.classList.add("flex");
          document.body.style.overflow = "hidden";
        }

        function close() {
          lightbox.classList.add("hidden");
          lightbox.classList.remove("flex");
          document.body.style.overflow = "";
        }

        trigger?.addEventListener("click", open);
        trigger?.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") open();
        });
        lightbox?.addEventListener("click", close);
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") close();
        });
      </script>
    </>
  )
}
