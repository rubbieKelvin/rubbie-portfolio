---
import Layout from "@/layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";
import Image from "@/components/Image.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props as { post: any };

if (!post) {
  return Astro.redirect("/404");
}

const { Content } = await render(post);

const formatDate = (dateString: string) =>
  new Date(dateString).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

const {
  title,
  description,
  publishedAt,
  mainImage,
  external_link,
  categories,
  author: authorSlug,
} = post.data;

const author = authorSlug ? await getEntry("authors", authorSlug) : null;
---

<Layout
  title={title}
  description={description ?? undefined}
  image={mainImage ?? undefined}
  article={publishedAt ? { publishedAt: publishedAt.toISOString() } : undefined}
>
  <div class="max-w-5xl mx-auto px-6">
    <!-- Back link -->
    <div class="pt-8 pb-2">
      <a
        href="/blog"
        class="text-xs font-semibold uppercase tracking-widest text-text-muted hover:text-accent transition-colors"
      >
        ← Back to Blog
      </a>
    </div>

    <!-- Article -->
    <article class="pb-16">
      <!-- Header -->
      <header class="pt-8 pb-10 border-b-2" style="border-color: var(--color-border)">
        <h1
          class="font-display font-black uppercase text-4xl md:text-5xl lg:text-6xl leading-tight tracking-tight mb-6"
          style="color: var(--color-text)"
        >
          {title}
        </h1>

        <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs font-medium text-text-muted">
          {
            publishedAt && (
              <time datetime={publishedAt.toISOString()}>
                {formatDate(publishedAt.toISOString())}
              </time>
            )
          }

          {
            author && (
              <span class="flex items-center gap-2">
                {author.data.image && (
                  <img
                    src={author.data.image}
                    alt={author.data.name}
                    class="w-5 h-5 rounded-full"
                  />
                )}
                <span>
                  by{" "}
                  <a
                    href={`/author/${author.data.slug}`}
                    class="hover:text-accent transition-colors font-semibold"
                    style="color: var(--color-text-muted)"
                  >
                    {author.data.name}
                  </a>
                </span>
              </span>
            )
          }

          {
            categories && categories.length > 0 && (
              <div class="flex gap-2 flex-wrap">
                {categories.map((category: string) => (
                  <span
                    class="border px-2 py-0.5 text-xs uppercase tracking-wide"
                    style="border-color: var(--color-border-muted); color: var(--color-text-muted)"
                  >
                    {category}
                  </span>
                ))}
              </div>
            )
          }
        </div>
      </header>

      <!-- External link notice -->
      {
        external_link && (
          <div
            class="my-8 p-5 border-l-4"
            style="border-color: var(--color-accent); background-color: var(--color-surface)"
          >
            <p class="text-sm mb-2" style="color: var(--color-text)">
              This post was originally published externally.
            </p>
            <a
              href={external_link}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-bold uppercase tracking-widest hover:text-accent transition-colors"
              style="color: var(--color-text-muted)"
            >
              Read the original →
            </a>
          </div>
        )
      }

      <!-- Main image -->
      {
        mainImage && (
          <div class="mt-8 mb-10">
            <Image
              src={mainImage}
              alt={title}
              class="w-full h-64 lg:h-96 object-cover"
              style="border: 2px solid var(--color-border-muted)"
            />
          </div>
        )
      }

      <!-- Content -->
      <div class="prose max-w-none mt-10">
        <Content />
      </div>
    </article>

    <!-- Bottom nav -->
    <div
      class="py-8 border-t-2"
      style="border-color: var(--color-border-muted)"
    >
      <a
        href="/blog"
        class="text-xs font-semibold uppercase tracking-widest text-text-muted hover:text-accent transition-colors"
      >
        ← Back to Blog
      </a>
    </div>
  </div>
</Layout>
