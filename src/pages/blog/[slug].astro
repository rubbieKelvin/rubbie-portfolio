---
import Layout from "@/layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props as { post: any };

if (!post) {
  return Astro.redirect("/404");
}

const { Content } = await render(post);

const formatDate = (dateString: string) =>
  new Date(dateString).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

const {
  title,
  description,
  publishedAt,
  mainImage,
  external_link,
  categories,
  author: authorSlug,
} = post.data;

const author = authorSlug ? await getEntry("authors", authorSlug) : null;
---

<Layout
  title={title}
  description={description ?? undefined}
  image={mainImage ?? undefined}
  article={publishedAt ? { publishedAt: publishedAt.toISOString() } : undefined}
>
  <!-- Hero -->
  {
    mainImage ? (
      <div
        class="relative w-full overflow-hidden cursor-zoom-in"
        style="height: clamp(500px, 82vh, 960px)"
        id="hero-image-trigger"
        role="button"
        tabindex="0"
        aria-label="Click to enlarge image"
      >
        <img
          src={mainImage}
          alt={title}
          id="hero-img"
          class="absolute inset-0 w-full h-full object-cover"
        />
        <div
          class="absolute inset-0"
          style="background: linear-gradient(to bottom, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.35) 40%, rgba(0,0,0,0.88) 100%)"
        />
        <div class="absolute inset-x-0 bottom-0 max-w-5xl mx-auto px-6 pb-10">
          {categories && categories.length > 0 && (
            <div class="flex gap-2 flex-wrap mb-4">
              {categories.map((cat: string) => (
                <span class="text-xs font-semibold uppercase tracking-widest opacity-70 text-white">
                  #{cat}
                </span>
              ))}
            </div>
          )}
          <h1
            class="font-display font-black uppercase leading-tight tracking-tight text-white mb-4"
            style="font-size: clamp(2rem, 6vw, 4.5rem)"
          >
            {title}
          </h1>
          <div class="flex flex-wrap items-center gap-x-5 gap-y-1 text-xs font-semibold uppercase tracking-widest text-white/60">
            {publishedAt && (
              <time datetime={publishedAt.toISOString()}>
                {formatDate(publishedAt.toISOString())}
              </time>
            )}
            {author && (
              <span>
                by{" "}
                <a
                  href={`/author/${author.data.slug}`}
                  class="hover:text-white transition-colors"
                >
                  {author.data.name}
                </a>
              </span>
            )}
          </div>
        </div>
      </div>
    ) : (
      <div
        class="max-w-5xl mx-auto px-6 pt-14 pb-12 border-b-2"
        style="border-color: var(--color-border)"
      >
        {categories && categories.length > 0 && (
          <div class="flex gap-2 flex-wrap mb-4">
            {categories.map((cat: string) => (
              <span class="text-xs font-semibold uppercase tracking-widest text-text-muted">
                #{cat}
              </span>
            ))}
          </div>
        )}
        <h1
          class="font-display font-black uppercase leading-tight tracking-tight mb-6"
          style="font-size: clamp(2rem, 6vw, 4.5rem); color: var(--color-text)"
        >
          {title}
        </h1>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-1 text-xs font-semibold uppercase tracking-widest text-text-muted">
          {publishedAt && (
            <time datetime={publishedAt.toISOString()}>
              {formatDate(publishedAt.toISOString())}
            </time>
          )}
          {author && (
            <span>
              by{" "}
              <a
                href={`/author/${author.data.slug}`}
                class="hover:text-accent transition-colors"
              >
                {author.data.name}
              </a>
            </span>
          )}
        </div>
      </div>
    )
  }

  <!-- Article body -->
  <div class="max-w-3xl mx-auto px-6 pt-12 pb-20">
    {
      external_link && (
        <div
          class="mb-10 p-5 border-l-4"
          style="border-color: var(--color-accent); background-color: var(--color-surface)"
        >
          <p class="text-sm mb-2" style="color: var(--color-text)">
            Originally published externally.
          </p>
          <a
            href={external_link}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-bold uppercase tracking-widest hover:text-accent transition-colors"
            style="color: var(--color-text-muted)"
          >
            Read the original
          </a>
        </div>
      )
    }

    <div class="prose max-w-none">
      <Content />
    </div>
  </div>
</Layout>

{
  mainImage && (
    <>
      <div
        id="lightbox"
        class="fixed inset-0 z-50 hidden items-center justify-center cursor-zoom-out"
        style="background: rgba(0,0,0,0.92)"
        role="dialog"
        aria-modal="true"
        aria-label="Image lightbox"
      >
        <img
          id="lightbox-img"
          src={mainImage}
          alt={title}
          class="w-[85vw] h-[75vh] object-contain select-none"
        />
      </div>

      <script>
        const trigger = document.getElementById("hero-image-trigger");
        const lightbox = document.getElementById("lightbox");

        function open() {
          lightbox.classList.remove("hidden");
          lightbox.classList.add("flex");
          document.body.style.overflow = "hidden";
        }

        function close() {
          lightbox.classList.add("hidden");
          lightbox.classList.remove("flex");
          document.body.style.overflow = "";
        }

        trigger?.addEventListener("click", open);
        trigger?.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") open();
        });
        lightbox?.addEventListener("click", close);
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") close();
        });
      </script>
    </>
  )
}
