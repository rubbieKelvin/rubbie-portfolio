---
import Layout from "@/layouts/Layout.astro";
import CurrentlyBuilding from "@/components/CurrentlyBuilding.astro";
import NowPlaying from "@/components/NowPlaying.astro";
import { getCollection } from "astro:content";
import introData from "@/data/intro.json";
import contactLinks from "@/data/links.json";

const posts = await getCollection("posts");
const recentPosts = [...posts]
    .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
    .slice(0, 5);

const fmtDate = (d: Date) =>
    d
        .toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
        .toLowerCase();

const blogUrl = (post: any) => `/blog/${post.id.replace(/\.md$/, "")}`;
---

<Layout>
    <div class="flex items-center gap-5 mb-8">
        <img
            src="/rubbie-icon.png"
            alt="Rubbie, a cartoon self-portrait"
            class="avatar-lg"
            width="80"
            height="80"
        />
        <div>
            <h1 class="title !mb-1">rubbie kelvin</h1>
            <p class="muted">software engineer, nigeria.</p>
        </div>
    </div>

    <section class="section">
        <h2 class="label">about</h2>
        <div class="stack">
            <p>
                i love building tools, systems &amp; interfaces. my core
                expertise is in <strong>python</strong>,{" "}
                <strong>rust</strong> and <strong>typescript</strong>.
            </p>
            <p>
                i like software that feels simple on the surface but is
                thoughtfully engineered underneath.
            </p>
            <div class="slash-list">
                <a href="/projects" class="underline-link">projects</a>
                <a href="/blog" class="underline-link">writing</a>
                <a href={introData.action_url} target="_blank" rel="noopener noreferrer" class="underline-link">resume</a>
            </div>
        </div>
    </section>

    <section class="section">
        <h2 class="label">now</h2>
        <div class="stack">
            <CurrentlyBuilding />
            <NowPlaying />
        </div>
    </section>

    <section class="section">
        <h2 class="label">writing</h2>
        <div>
            {recentPosts.map((post) => (
                <a href={blogUrl(post)} class="row">
                    <span class="row-title">{post.data.title}</span>
                    <span class="row-meta">{fmtDate(post.data.publishedAt)}</span>
                </a>
            ))}
        </div>
    </section>

    <section class="section">
        <h2 class="label">elsewhere</h2>
        <div class="slash-list">
            {contactLinks.map((link) => (
                <a href={link.url} target="_blank" rel="noopener noreferrer" class="underline-link">
                    {link.title.toLowerCase()}
                </a>
            ))}
        </div>
    </section>
</Layout>
