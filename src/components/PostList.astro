---
import type { CollectionEntry } from "astro:content";
import GrepFilter from "./GrepFilter.astro";

type Props = {
  posts: CollectionEntry<"posts">[];
};

const { posts } = Astro.props;

const sorted = [...posts].sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

const years = [
  ...new Set(sorted.map((p) => p.data.publishedAt.getFullYear())),
];

const blogUrl = (post: CollectionEntry<"posts">) =>
  `/blog/${post.id.replace(/\.md$/, "")}`;

const fmtShortDate = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "short", day: "numeric" });

const domainOf = (url?: string | null) => {
  if (!url) return null;
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return null;
  }
};

const searchFor = (post: CollectionEntry<"posts">) =>
  [
    post.data.title,
    post.data.description,
    post.data.categories.join(" "),
    post.data.publishedAt.getFullYear().toString(),
    domainOf(post.data.external_link),
  ]
    .filter(Boolean)
    .join(" ")
    .toLowerCase();
---

<GrepFilter total={sorted.length} unit="posts">
  {
    years.map((year) => {
      const yearPosts = sorted.filter(
        (p) => p.data.publishedAt.getFullYear() === year,
      );
      return (
        <section data-group class="mb-10">
          <p class="mb-3 text-xs uppercase tracking-widest font-semibold text-text-muted">
            {year}
          </p>
          {yearPosts.map((post, i) => (
            <a
              href={blogUrl(post)}
              data-item
              data-search={searchFor(post)}
              class="group flex items-center justify-between gap-4 py-3.5 border-b transition-colors hover:border-[var(--color-border)]"
              style="border-color: var(--color-border-muted)"
            >
              <div class="flex items-center gap-4 min-w-0">
                <span class="text-xs text-text-muted font-mono shrink-0 w-5 text-right select-none">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="min-w-0">
                  <span class="block font-semibold group-hover:text-accent transition-colors truncate">
                    {post.data.title}
                  </span>
                  {post.data.categories.length > 0 && (
                    <span class="block mt-0.5 text-xs text-text-muted">
                      {post.data.categories.map((c: string) => `#${c}`).join(" ")}
                      {domainOf(post.data.external_link) &&
                        ` → ${domainOf(post.data.external_link)}`}
                    </span>
                  )}
                </span>
              </div>
              <span class="text-xs text-text-muted shrink-0 font-medium">
                {fmtShortDate(post.data.publishedAt)}
              </span>
            </a>
          ))}
        </section>
      );
    })
  }
</GrepFilter>
