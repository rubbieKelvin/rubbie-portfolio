---
type Line = {
  cmd: string;
  out?: string[];
};

type Props = {
  /** Optional directory-ish label shown above the block */
  label?: string;
  lines: Line[];
};

const { label, lines } = Astro.props;
---

<div class="my-6">
  {label && (
    <p class="mb-1 text-xs text-text-muted">-- {label} --</p>
  )}
  <div class="border border-border p-4 text-xs overflow-x-auto">
    {
      lines.map((line) => (
        <div class="whitespace-pre-wrap">
          <p class="text-text">
            <span class="text-text-muted">$ </span>
            <span>{line.cmd}</span>
            
          </p>
          {line.out?.map((o) => (
            <p class="text-text-muted">{o}</p>
          ))}
        </div>
      ))
    }
  </div>
</div>
