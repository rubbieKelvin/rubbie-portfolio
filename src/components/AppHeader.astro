---
const pathname = Astro.url.pathname;
const isHome = pathname === "/";

const navLinks = [
    { title: "projects", url: "/projects" },
    { title: "writing", url: "/blog" },
];
---

<header class="mb-10">
    {
        isHome ? null : (
            <div class="flex items-center justify-between">
                <a href="/" class="flex items-center gap-3 nav-link">
                    <img src="/rubbie-icon.png" alt="" class="avatar" width="32" height="32" />
                    <span class="strong">rubbie kelvin</span>
                </a>
                <nav class="flex gap-5 small">
                    {navLinks.map((link) => (
                        <a
                            href={link.url}
                            class="nav-link"
                            aria-current={pathname.startsWith(link.url) ? "page" : undefined}
                        >
                            {link.title}
                        </a>
                    ))}
                </nav>
            </div>
        )
    }
</header>
