---
const pathname = Astro.url.pathname;
const isHome = pathname === "/";

const navLinks = [
    { title: "projects", url: "/projects" },
    { title: "writing", url: "/blog" },
];
---

{isHome && <div class="mb-10" />}
{!isHome && <div id="header-sentinel" class="h-px -mb-px" aria-hidden="true" />}
<header class="site-header" data-home={isHome}>
    {
        isHome ? null : (
            <div class="flex items-center justify-between">
                <a href="/" class="flex items-center gap-3 nav-link">
                    <img src="/rubbie-icon.png" alt="" class="avatar" width="32" height="32" />
                    <span class="strong">rubbie kelvin</span>
                </a>
                <nav class="flex gap-5 small">
                    {navLinks.map((link) => (
                        <a
                            href={link.url}
                            class="nav-link"
                            aria-current={pathname.startsWith(link.url) ? "page" : undefined}
                        >
                            {link.title}
                        </a>
                    ))}
                </nav>
            </div>
        )
    }
</header>

<script>
    const header = document.querySelector<HTMLElement>(".site-header");
    const sentinel = document.getElementById("header-sentinel");
    if (header && sentinel) {
        new IntersectionObserver(([entry]) => {
            header.toggleAttribute("data-stuck", !entry.isIntersecting);
        }).observe(sentinel);
    }
</script>
