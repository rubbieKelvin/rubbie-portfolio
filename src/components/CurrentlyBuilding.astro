---
import building from "@/data/currently-building.json";

const domain = new URL(building.url).hostname.replace(/^www\./, "");
---

<a
    href={building.url}
    target="_blank"
    rel="noopener noreferrer"
    title={building.tagline}
    class="group mb-4 block text-xs sm:text-sm cursor-underline-effect"
>
    <span class="text-text">
        currently building:{" "}
        <span class="text-accent transition-colors">{domain}</span>
    </span>{" "}
    <span class="animate-blink text-accent" aria-hidden="true">▋</span>
</a>
