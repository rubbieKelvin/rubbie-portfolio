---
import building from "@/data/currently-building.json";

const domain = new URL(building.url).hostname.replace(/^www\./, "");
---

<section class="mt-16">
  <div
    class="flex items-baseline justify-between mb-6 border-b-2 pb-3"
    style="border-color: var(--color-border)"
  >
    <h2
      class="font-display font-bold text-xs uppercase tracking-widest"
      style="color: var(--color-text)"
    >
      Building Now
    </h2>
  </div>

  <a
    href={building.url}
    target="_blank"
    rel="noopener noreferrer"
    class="group block border-2 p-6 transition-colors hover:border-accent"
    style="border-color: var(--color-border)"
  >
    <div class="flex items-start justify-between gap-4">
      <div>
        <h3
          class="font-display font-black text-2xl uppercase tracking-tight group-hover:text-accent transition-colors"
        >
          {building.name}
        </h3>
        <p class="mt-2 text-text-muted text-sm leading-relaxed">
          {building.tagline}
        </p>
        <p
          class="mt-4 text-xs font-semibold uppercase tracking-widest text-text-muted group-hover:text-accent transition-colors"
        >
          {domain}
        </p>
      </div>
      <span
        class="text-xs font-semibold uppercase tracking-widest text-text-muted shrink-0 pt-1"
      >
        Active
      </span>
    </div>
  </a>
</section>
