---
import building from "@/data/currently-building.json";

const domain = new URL(building.url).hostname.replace(/^www\./, "");
---

<a
    href={building.url}
    target="_blank"
    rel="noopener noreferrer"
    class="group inline-flex items-center gap-3 border border-border/60 bg-accent-bg/40 px-4 py-2.5 w-fit cursor-underline-effect"
>
    <span class="relative flex h-2.5 w-2.5 shrink-0" aria-hidden="true">
        <span
            class="sonar-ring absolute inline-flex h-full w-full rounded-full bg-accent animate-sonar"
        ></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-accent"></span>
    </span>
    <span class="text-sm leading-tight">
        <span class="text-text-muted">currently building:</span>{" "}
        <span class="text-text transition-colors group-hover:text-accent">{building.name}</span>
        <span class="block mt-0.5 text-xs text-text-muted">
            {building.tagline} <span class="text-accent">-&gt;</span> {domain}
        </span>
    </span>
</a>
