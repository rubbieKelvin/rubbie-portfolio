---
import type { CollectionEntry } from "astro:content";
import GrepFilter from "./GrepFilter.astro";

type Props = {
  groups: {
    title: string;
    projects: CollectionEntry<"projects">[];
  }[];
  detailed: Set<string>;
  title?: string;
  description?: string;
};

const { groups, detailed, title, description } = Astro.props;
const total = groups.reduce((n, g) => n + g.projects.length, 0);

const searchFor = (project: CollectionEntry<"projects">) =>
  [
    project.data.title,
    project.data.description,
    project.data.categories.join(" "),
    project.data.url,
  ]
    .filter(Boolean)
    .join(" ")
    .toLowerCase();
---

<GrepFilter total={total} unit="projects" title={title} description={description}>
  {
    groups.map((group) => (
      <section data-group class="mb-8">
        <p class="mb-2 small muted">{group.title.toLowerCase()}</p>
        {group.projects.map((project) => {
          const hasDetail = detailed.has(project.id);
          return (
            <a
              href={hasDetail ? `/projects/${project.id}` : project.data.url}
              target={hasDetail ? undefined : "_blank"}
              rel={hasDetail ? undefined : "noopener noreferrer"}
              data-item
              data-search={searchFor(project)}
              class="row py-2"
            >
              <span class="row-title">
                <span class="strong">{project.data.title.toLowerCase()}</span>
                {project.data.description && (
                  <span class="muted block">{project.data.description}</span>
                )}
                {project.data.categories.length > 0 && (
                  <span class="tags block">
                    {project.data.categories.map((c: string) => `#${c}`).join(" ")}
                  </span>
                )}
              </span>
              <span class="row-meta">{hasDetail ? "notes" : "visit"}</span>
            </a>
          );
        })}
      </section>
    ))
  }
</GrepFilter>
