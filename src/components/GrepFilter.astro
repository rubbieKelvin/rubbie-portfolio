---
type Props = {
  total: number;
  unit: string;
  title?: string;
  description?: string;
};

const { total, unit, title, description } = Astro.props;
---

<div class="flex items-baseline gap-4">
  {title && <h1 class="title !mb-0 shrink-0">{title}</h1>}
  <input
    id="grep-input"
    type="text"
    placeholder="filter (/)"
    autocomplete="off"
    autocapitalize="off"
    spellcheck="false"
    aria-label="Filter list"
    class="filter-input flex-1 min-w-0"
  />
  <span id="file-count" data-unit={unit} class="small muted shrink-0">
    {total}
    {unit}
  </span>
</div>

{description && <p class="mt-4">{description}</p>}

<div class="mt-8">
  <slot />
</div>

<p id="no-matches" class="hidden muted py-8">no results for that search.</p>

<script>
  const input = document.getElementById("grep-input") as HTMLInputElement;
  const rows = Array.from(document.querySelectorAll("[data-item]"));
  const groups = Array.from(document.querySelectorAll("[data-group]"));
  const count = document.getElementById("file-count") as HTMLElement;
  const noMatches = document.getElementById("no-matches") as HTMLElement;
  const unit = count.dataset.unit;

  function applyFilter() {
    const q = input.value.trim().toLowerCase();
    let visible = 0;
    for (const row of rows) {
      const hit = !q || (row as HTMLElement).dataset.search?.includes(q);
      row.classList.toggle("hidden", !hit);
      if (hit) visible += 1;
    }
    for (const group of groups) {
      group.classList.toggle(
        "hidden",
        !group.querySelector("[data-item]:not(.hidden)"),
      );
    }
    count.textContent = q ? `${visible}/${rows.length}` : `${rows.length} ${unit}`;
    noMatches.classList.toggle("hidden", visible !== 0);
  }

  input.addEventListener("input", applyFilter);
  applyFilter();

  document.addEventListener("keydown", (e) => {
    if (e.key === "/" && document.activeElement !== input) {
      e.preventDefault();
      input.focus();
    }
  });
</script>
