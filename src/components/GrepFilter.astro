---
type Props = {
  total: number;
  unit: string;
};

const { total, unit } = Astro.props;
---

<div
  class="mb-8 flex flex-col sm:flex-row sm:items-center gap-3 border-b-2 pb-4"
  style="border-color: var(--color-border)"
>
  <label
    for="grep-input"
    class="text-xs uppercase tracking-widest font-semibold text-text-muted shrink-0"
  >
    Filter
  </label>
  <input
    id="grep-input"
    type="text"
    placeholder="Search..."
    autocomplete="off"
    autocapitalize="off"
    spellcheck="false"
    aria-label="Filter list"
    class="flex-1 min-w-0 bg-transparent outline-none py-1 text-sm placeholder:text-text-muted/50 caret-accent"
    style="color: var(--color-text)"
  />
  <span
    id="file-count"
    data-unit={unit}
    class="text-xs text-text-muted shrink-0 font-medium"
  >
    {total}
    {unit}
  </span>
</div>

<slot />

<p id="no-matches" class="hidden text-text-muted py-12 text-sm">
  No results for that search.
</p>

<script>
  const input = document.getElementById("grep-input") as HTMLInputElement;
  const rows = Array.from(document.querySelectorAll("[data-item]"));
  const groups = Array.from(document.querySelectorAll("[data-group]"));
  const count = document.getElementById("file-count") as HTMLElement;
  const noMatches = document.getElementById("no-matches") as HTMLElement;
  const unit = count.dataset.unit;

  function applyFilter() {
    const q = input.value.trim().toLowerCase();
    let visible = 0;
    for (const row of rows) {
      const hit = !q || (row as HTMLElement).dataset.search?.includes(q);
      row.classList.toggle("hidden", !hit);
      if (hit) visible += 1;
    }
    for (const group of groups) {
      group.classList.toggle(
        "hidden",
        !group.querySelector("[data-item]:not(.hidden)"),
      );
    }
    count.textContent = `${visible} of ${rows.length} ${unit}`;
    noMatches.classList.toggle("hidden", visible !== 0);
  }

  input.addEventListener("input", applyFilter);
  applyFilter();

  document.addEventListener("keydown", (e) => {
    if (e.key === "/" && document.activeElement !== input) {
      e.preventDefault();
      input.focus();
    }
  });
</script>
