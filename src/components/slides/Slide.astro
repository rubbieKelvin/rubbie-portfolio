---
/** Shared frame for a slide: optional kicker + title, body, and hidden speaker notes (dev builds only). */
type Props = {
  kicker?: string;
  title?: string;
  notes?: string;
  /** Always render this slide in the dark palette, whatever the site theme */
  dark?: boolean;
  class?: string;
};

const { kicker, title, notes, dark, class: className } = Astro.props;
---

<div class:list={["s", className]} data-dark={dark ? "" : undefined}>
  {kicker && <p class="s-kicker">{kicker}</p>}
  {title && <h2 class="s-title">{title}</h2>}
  <div class="s-body">
    <slot />
  </div>
  {/* notes only ship in dev, for the presenter view; production HTML never contains them */}
  {notes && import.meta.env.DEV && <aside class="s-notes" hidden>{notes}</aside>}
</div>
