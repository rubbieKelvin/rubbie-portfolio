---
import "@/assets/global.css";
import AppHeader from "@/components/AppHeader.astro";
import AppFooter from "@/components/AppFooter.astro";
import GoogleAnalytics from "@/components/GoogleAnalytics.astro";

type Props = {
  title?: string;
  description?: string;
  image?: string;
  article?: {
    publishedAt: string;
  };
};

const { title, description, image, article } = Astro.props;

const pageTitle = title ? `${title} | Rubbie Kelvin` : "Rubbie Kelvin";
const siteUrl = (Astro.site?.toString() || Astro.url.origin).replace(/\/$/, "");
const imageUrl = image ? image : `${siteUrl}/rto.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <script
      is:inline
      defer
      src="https://scripts.brimble.io/analytics/brimble.js"
      data-website-id="aebe9b72-87d4-4d0d-889a-03b6ceba20ff"
    ></script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Rubbie Kelvin" />
    <meta
      name="keywords"
      content="Rubbie Kelvin, Software Developer, Python Developer, JavaScript Developer, TypeScript Developer, Rust Developer, Nigerian Developer, Full Stack Developer, Portfolio"
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {
      article ? (
        <meta property="og:type" content="article" />
      ) : (
        <meta property="og:type" content="website" />
      )
    }
    <meta property="og:url" content={`${siteUrl}${Astro.url.pathname}`} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:image:width" content="1042" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:creator" content="@rubbiekelvin" />
    {
      article && (
        <>
          <meta property="article:author" content="Rubbie Kelvin" />
          <meta
            property="article:published_time"
            content={article.publishedAt}
          />
        </>
      )
    }

    <meta
      id="theme-color-meta-dark"
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#080808"
    />
    <meta
      id="theme-color-meta-light"
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#ffffff"
    />

    <script is:inline>
      (function () {
        let storedTheme = null;
        try {
          storedTheme = localStorage.getItem("theme");
        } catch (e) {}
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        const theme = storedTheme || (prefersDark ? "dark" : "light");
        const html = document.documentElement;
        html.setAttribute("data-theme", theme);
        html.style.colorScheme = theme;
        const metaDark = document.getElementById("theme-color-meta-dark");
        const metaLight = document.getElementById("theme-color-meta-light");
        function syncThemeColor() {
          const current = html.getAttribute("data-theme") || "light";
          const color = current === "dark" ? "#080808" : "#ffffff";
          metaDark?.setAttribute("content", color);
          metaLight?.setAttribute("content", color);
        }
        syncThemeColor();
        new MutationObserver(syncThemeColor).observe(html, {
          attributes: true,
          attributeFilter: ["data-theme"],
        });
      })();
    </script>
  </head>

  <body class="min-h-full flex flex-col">
    <AppHeader />
    <main class="flex-grow">
      <slot />
    </main>
    <AppFooter />
    <GoogleAnalytics />
  </body>
</html>
